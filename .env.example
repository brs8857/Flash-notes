# Flash Notes — example environment file. Copy to `.env` (which is git-ignored) if you use the Supabase CLI
# on your own computer. NOTHING in this file is read by the app: the app is static files and only knows
# the two PUBLIC values in js/config.js.

# Used by the Supabase CLI (supabase link / db push / functions deploy).
SUPABASE_ACCESS_TOKEN=            # personal access token from supabase.com/dashboard/account/tokens
SUPABASE_DB_PASSWORD=             # the database password you chose when creating the project
SUPABASE_PROJECT_REF=             # e.g. abcdefghijklmnopqrst

# Google OAuth client (entered in the Supabase dashboard, Authentication → Providers → Google; kept here
# only so you have one private place to note them).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Secret for the delete-account Edge Function (set with `supabase secrets set`, see SETUP.md step 5).
ALLOWED_ORIGINS=https://brs8857.github.io

# The service-role key is provided to Edge Functions automatically by Supabase as SUPABASE_SERVICE_ROLE_KEY.
# Do not copy it anywhere: not here, not into js/config.js, not into the repository.
